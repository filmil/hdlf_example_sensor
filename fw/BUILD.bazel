# SPDX-License-Identifier: Apache-2.0
#
# The sensor's firmware (issue #14), in Rust for the STM32F042F6's Cortex-M0
# (thumbv6m-none-eabi): a USB CDC serial device that prints the HDC2080's
# reading once a second (README.md). Also its raw flash image, the pin map,
# the sensor's driver, and the checks: the flash and RAM budget,
# determinism, and the crates' licences.
load("@hdlf_rules_netlist//netlist:defs.bzl", "determinism_test")
load(":firmware.bzl", "firmware")
load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_test.bzl", "py_test")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "Cargo.lock",
    "stm32-metapac-device-x.patch",
])

platform(
    name = "stm32f042",
    constraint_values = [
        "@platforms//cpu:armv6-m",
        "@platforms//os:none",
    ],
)

# The firmware's code. Built only for the chip: a host build skips it.
# :fw is what to build.
rust_binary(
    name = "fw_code",
    srcs = ["src/main.rs"],
    compile_data = ["memory.x"],
    crate_name = "fw",
    rustc_flags = [
        "-Clink-arg=-Tlink.x",
        "-Clink-arg=-L" + package_name(),
    ],
    target_compatible_with = [
        "@platforms//cpu:armv6-m",
        "@platforms//os:none",
    ],
    visibility = ["//visibility:private"],
    deps = [
        ":hdc2080",
        ":pins",
        "@crates//:cortex-m",
        "@crates//:cortex-m-rt",
        "@crates//:embassy-executor",
        "@crates//:embassy-stm32",
        "@crates//:embassy-sync",
        "@crates//:embassy-time",
        "@crates//:embassy-usb",
        "@crates//:panic-halt",
        "@crates//:static_cell",
        "@crates//:stm32-metapac",
    ],
)

# The firmware ELF, fw.elf: :fw_code for the STM32F042F6 in opt mode,
# with fat LTO, opt-level z and panic=abort in every crate (firmware.bzl).
firmware(
    name = "fw",
    binary = ":fw_code",
    platform = ":stm32f042",
)

# The raw flash image, for DFU: fw.bin.
genrule(
    name = "fw_bin",
    srcs = [":fw"],
    outs = ["fw.bin"],
    cmd = "$(execpath //fw/tools:elf2bin) $< $@",
    tools = ["//fw/tools:elf2bin"],
)

# The ELF fits 32 KB of flash and 6 KB of RAM with 1 KB of stack; a chip
# one byte short fails; the vector table is sound; fw.bin is its image.
rust_test(
    name = "budget_test",
    size = "small",
    srcs = ["test/budget_test.rs"],
    data = [
        ":fw",
        ":fw_bin",
    ],
    env = {
        "FW_BIN": "$(rootpath :fw_bin)",
        "FW_ELF": "$(rootpath :fw)",
    },
    deps = ["//fw/tools:elf"],
)

# Every crate in Cargo.lock has an allowed licence.
rust_test(
    name = "licence_test",
    size = "small",
    srcs = ["test/licence_test.rs"],
    data = [
        "Cargo.lock",
        "crate_licences.txt",
    ],
    env = {
        "CARGO_LOCK": "$(rootpath Cargo.lock)",
        "LICENCES": "$(rootpath crate_licences.txt)",
    },
)

# The ELF and the image, the same from two configurations.
determinism_test(
    name = "fw_determinism_test",
    size = "small",
    target = ":fw_outputs",
)

filegroup(
    name = "fw_outputs",
    srcs = [
        ":fw",
        ":fw_bin",
    ],
)

# The pin map (issue #14, step 2): pins.rs, a const per MCU net the
# firmware uses, from the board's netlist. The build fails if a net is
# missing or sits on a pin without the function pins.json asks for,
# checked against the KiCad symbol and stm32-metapac's metadata.
py_binary(
    name = "gen_pins",
    srcs = ["pinmap/pinmap.py"],
    main = "pinmap/pinmap.py",
)

_PINMAP_INPUTS = {
    "metadata": "@crates//:stm32-metapac-metadata",
    "netlist": "//elec:netlist",
    "spec": "pins.json",
    "symbols": "@kicad_libs//:symbols/MCU_ST_STM32F0.kicad_sym",
}

# The inputs are tools, not srcs: tools build for the build machine, while
# srcs would follow :fw's transition to the chip, where the netlist's own
# tools have no toolchain.
genrule(
    name = "pins_rs",
    outs = ["pins.rs"],
    cmd = " ".join([
        "$(execpath :gen_pins)",
        "--netlist $(execpath //elec:netlist)",
        "--symbols $(execpath @kicad_libs//:symbols/MCU_ST_STM32F0.kicad_sym)",
        "$$(for m in $(execpaths @crates//:stm32-metapac-metadata); do echo --metadata $$m; done)",
        "--spec $(execpath pins.json)",
        "--out $@",
    ]),
    tools = [":gen_pins"] + _PINMAP_INPUTS.values(),
)

# The pin map as a crate, for the firmware and for host tests.
rust_library(
    name = "pins",
    srcs = [":pins_rs"],
    crate_root = ":pins_rs",
)

# What the board says, as the firmware will use it: USB on the remapped
# PA11/PA12, I2C1 on PF0/PF1 with AF1, the LED on PA4.
rust_test(
    name = "pins_test",
    size = "small",
    srcs = ["test/pins_test.rs"],
    deps = [":pins"],
)

# The generator's known-bad cases: the real netlist, spec and metadata,
# edited so each check fails (pinmap/pinmap_test.py).
py_test(
    name = "pinmap_test",
    size = "small",
    srcs = [
        "pinmap/pinmap.py",
        "pinmap/pinmap_test.py",
    ],
    args = [
        "--netlist $(rootpath //elec:netlist)",
        "--symbols $(rootpath @kicad_libs//:symbols/MCU_ST_STM32F0.kicad_sym)",
        "--metadata $(rootpaths @crates//:stm32-metapac-metadata)",
        "--spec $(rootpath pins.json)",
    ],
    data = _PINMAP_INPUTS.values(),
    main = "pinmap/pinmap_test.py",
)

# The HDC2080 driver and the reading's line (issue #14, step 3): a no_std
# crate, from the datasheet (SNAS678C).
rust_library(
    name = "hdc2080",
    srcs = ["hdc2080/lib.rs"],
    deps = [
        "@crates//:embassy-futures",
        "@crates//:embedded-hal-async",
        "@crates//:heapless",
    ],
)

# The driver on the host: conversions against the datasheet's formulas, the
# line, and every transaction on a fake I2C bus.
rust_test(
    name = "hdc2080_test",
    size = "small",
    srcs = ["test/hdc2080_test.rs"],
    deps = [
        ":hdc2080",
        "@crates//:embassy-futures",
        "@crates//:embedded-hal",
        "@crates//:embedded-hal-async",
    ],
)

# bazel run //fw:flash: writes fw.bin over the STM32's ROM USB DFU
# bootloader with dfu-util (flash/flash.rs says how). Manual: never built
# by //..., run in CI or by an agent; it is for the operator, with the
# board on BOOT0. The static dfu-util is x86_64 Linux only.
rust_binary(
    name = "flash",
    srcs = ["flash/flash.rs"],
    data = [
        ":fw_bin",
        "//third_party/dfu_util",
    ],
    rustc_env = {
        "DFU_UTIL": "$(rlocationpath //third_party/dfu_util)",
        "FW_BIN": "$(rlocationpath :fw_bin)",
    },
    tags = ["manual"],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = [":flash_lib"],
)

# //fw:flash's arguments, which CI builds and tests although //fw:flash
# itself is manual.
rust_library(
    name = "flash_lib",
    srcs = ["flash/lib.rs"],
    deps = ["@rules_rust//rust/runfiles"],
)

rust_test(
    name = "flash_lib_test",
    size = "small",
    srcs = ["flash/lib_test.rs"],
    deps = [":flash_lib"],
)
