# SPDX-License-Identifier: Apache-2.0
#
# The sensor's firmware (issue #14), in Rust for the STM32F042F6's Cortex-M0
# (thumbv6m-none-eabi): a USB CDC serial device that prints the HDC2080's
# reading once a second (README.md). Also its raw flash image, the pin map,
# the sensor's driver, and the checks: the flash and RAM budget,
# determinism, and the crates' licences.
load("@hdlf_rules_netlist//netlist:defs.bzl", "determinism_test")
load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_test.bzl", "py_test")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load(":firmware.bzl", "firmware")
load(":label_dir.bzl", "label_dir")

package(default_visibility = ["//visibility:public"])

# For bazel-cad-book, which quotes firmware.bzl through example_file.
exports_files(["firmware.bzl"])

platform(
    name = "stm32f042",
    constraint_values = [
        "@platforms//cpu:armv6-m",
        "@platforms//os:none",
    ],
)

# The firmware's code. Built only for the chip: a host build skips it.
# :fw is what to build.
rust_binary(
    name = "fw_code",
    srcs = ["src/main.rs"],
    compile_data = [
        "memory.x",
        "//third_party/crates:stm32-metapac-device-x",
    ],
    crate_name = "fw",
    rustc_flags = [
        "-Clink-arg=-Tlink.x",
        "-Clink-arg=-L" + label_dir("//fw:memory.x"),
        "-Clink-arg=-L" + label_dir("@crates__stm32-metapac-21.0.0//:src/chips/stm32f042f6/device.x"),
    ],
    target_compatible_with = [
        "@platforms//cpu:armv6-m",
        "@platforms//os:none",
    ],
    visibility = ["//visibility:private"],
    deps = [
        ":hdc2080",
        ":pins",
        "//third_party/crates:cortex-m",
        "//third_party/crates:cortex-m-rt",
        "//third_party/crates:embassy-executor",
        "//third_party/crates:embassy-stm32",
        "//third_party/crates:embassy-sync",
        "//third_party/crates:embassy-time",
        "//third_party/crates:embassy-usb",
        "//third_party/crates:panic-halt",
        "//third_party/crates:static_cell",
        "//third_party/crates:stm32-metapac",
    ],
)

# The firmware ELF, fw.elf: :fw_code for the STM32F042F6 in opt mode,
# with fat LTO, opt-level z and panic=abort in every crate (firmware.bzl).
firmware(
    name = "fw",
    binary = ":fw_code",
    platform = ":stm32f042",
)

# The raw flash image, for DFU: fw.bin.
genrule(
    name = "fw_bin",
    srcs = [":fw"],
    outs = ["fw.bin"],
    cmd = "$(execpath //fw/tools:elf2bin) $< $@",
    tools = ["//fw/tools:elf2bin"],
)

# The budget and the memory map as tables, for the book (bazel-cad-book
# draws them): from the ELF, through //fw/tools:elf, as budget_test's
# numbers are; budget_test checks that they agree.
genrule(
    name = "fw_tables",
    srcs = [":fw"],
    outs = [
        "budget.tsv",
        "memmap.tsv",
    ],
    cmd = "$(execpath //fw/tools:fw_tables) $< $(execpath budget.tsv) $(execpath memmap.tsv)",
    tools = ["//fw/tools:fw_tables"],
)

filegroup(
    name = "budget_tsv",
    srcs = ["budget.tsv"],
)

filegroup(
    name = "memmap_tsv",
    srcs = ["memmap.tsv"],
)

# The book's tables, the same from two configurations.
determinism_test(
    name = "tables_determinism_test",
    size = "small",
    target = ":book_tables",
)

filegroup(
    name = "book_tables",
    srcs = [
        ":budget_tsv",
        ":memmap_tsv",
        ":pinout_tsv",
    ],
)

# The ELF fits 32 KB of flash and 6 KB of RAM with 1 KB of stack; a chip
# one byte short fails; the vector table is sound; fw.bin is its image.
# Also: its use is the one recorded in the test, so a PR that changes the
# size shows by how much, and it leaves headroom (flash at most 90 %, 2 KB
# of stack). The book's budget and memory-map tables agree with it.
# --nocapture puts the numbers in the test log; one thread
# keeps the lines in order.
rust_test(
    name = "budget_test",
    size = "small",
    srcs = ["test/budget_test.rs"],
    args = [
        "--nocapture",
        "--test-threads=1",
    ],
    data = [
        ":budget_tsv",
        ":fw",
        ":fw_bin",
        ":memmap_tsv",
    ],
    env = {
        "BUDGET_TSV": "$(rootpath :budget_tsv)",
        "FW_BIN": "$(rootpath :fw_bin)",
        "FW_ELF": "$(rootpath :fw)",
        "MEMMAP_TSV": "$(rootpath :memmap_tsv)",
    },
    deps = ["//fw/tools:elf"],
)

# Every crate in Cargo.lock has an allowed licence. Its licence files are
# checked by //third_party/crates:licence_dirs_test.
rust_test(
    name = "licence_test",
    size = "small",
    srcs = ["test/licence_test.rs"],
    data = [
        "//third_party/crates:Cargo.lock",
        "//third_party/crates:crate_licences.txt",
    ],
    env = {
        "CARGO_LOCK": "$(rootpath //third_party/crates:Cargo.lock)",
        "LICENCES": "$(rootpath //third_party/crates:crate_licences.txt)",
    },
)

# The ELF and the image, the same from two configurations.
determinism_test(
    name = "fw_determinism_test",
    size = "small",
    target = ":fw_outputs",
)

filegroup(
    name = "fw_outputs",
    srcs = [
        ":fw",
        ":fw_bin",
    ],
)

# The pin map (issue #14, step 2): pins.rs, a const per MCU net the
# firmware uses, from the board's netlist. The build fails if a net is
# missing or sits on a pin without the function pins.json asks for,
# checked against the KiCad symbol and stm32-metapac's metadata.
py_binary(
    name = "gen_pins",
    srcs = ["pinmap/pinmap.py"],
    main = "pinmap/pinmap.py",
)

_PINMAP_INPUTS = {
    "metadata": "//third_party/crates:stm32-metapac-metadata",
    "netlist": "//elec:netlist",
    "spec": "pins.json",
    "symbols": "@kicad_libs//:symbols/MCU_ST_STM32F0.kicad_sym",
}

# The inputs are tools, not srcs: tools build for the build machine, while
# srcs would follow :fw's transition to the chip, where the netlist's own
# tools have no toolchain. pins_rs is the pin map as Rust; pinout_tsv is
# the pinout as a table for the book (bazel-cad-book draws it): one row
# per pin of U1, from the same checks.
[genrule(
    name = name,
    outs = [out],
    cmd = " ".join([
        "$(execpath :gen_pins)",
        "--format " + fmt,
        "--netlist $(execpath //elec:netlist)",
        "--symbols $(execpath @kicad_libs//:symbols/MCU_ST_STM32F0.kicad_sym)",
        "$$(for m in $(execpaths //third_party/crates:stm32-metapac-metadata); do echo --metadata $$m; done)",
        "--spec $(execpath pins.json)",
        "--out $@",
    ]),
    tools = [":gen_pins"] + _PINMAP_INPUTS.values(),
) for name, out, fmt in [
    ("pins_rs", "pins.rs", "rust"),
    ("pinout_tsv", "pinout.tsv", "tsv"),
]]

# The table and pins.rs agree, net by net: the same port and alternate
# function.
py_test(
    name = "pinout_tsv_test",
    size = "small",
    srcs = ["test/pinout_tsv_test.py"],
    data = [
        ":pinout_tsv",
        ":pins_rs",
    ],
    env = {
        "PINOUT_TSV": "$(rootpath :pinout_tsv)",
        "PINS_RS": "$(rootpath :pins_rs)",
    },
    main = "test/pinout_tsv_test.py",
)

# The pin map as a crate, for the firmware and for host tests.
rust_library(
    name = "pins",
    srcs = [":pins_rs"],
    crate_root = ":pins_rs",
)

# What the board says, as the firmware will use it: USB on the remapped
# PA11/PA12, I2C1 on PF0/PF1 with AF1, the LED on PA4.
rust_test(
    name = "pins_test",
    size = "small",
    srcs = ["test/pins_test.rs"],
    deps = [":pins"],
)

# The generator's known-bad cases: the real netlist, spec and metadata,
# edited so each check fails (pinmap/pinmap_test.py).
py_test(
    name = "pinmap_test",
    size = "small",
    srcs = [
        "pinmap/pinmap.py",
        "pinmap/pinmap_test.py",
    ],
    args = [
        "--netlist $(rootpath //elec:netlist)",
        "--symbols $(rootpath @kicad_libs//:symbols/MCU_ST_STM32F0.kicad_sym)",
        "--metadata $(rootpaths //third_party/crates:stm32-metapac-metadata)",
        "--spec $(rootpath pins.json)",
    ],
    data = _PINMAP_INPUTS.values(),
    main = "pinmap/pinmap_test.py",
)

# The HDC2080 driver and the reading's line (issue #14, step 3): a no_std
# crate, from the datasheet (SNAS678C).
rust_library(
    name = "hdc2080",
    srcs = ["hdc2080/lib.rs"],
    deps = [
        "//third_party/crates:embassy-futures",
        "//third_party/crates:embedded-hal-async",
        "//third_party/crates:heapless",
    ],
)

# The driver on the host: conversions against the datasheet's formulas, the
# line, and every transaction on a fake I2C bus.
rust_test(
    name = "hdc2080_test",
    size = "small",
    srcs = ["test/hdc2080_test.rs"],
    deps = [
        ":hdc2080",
        "//third_party/crates:embassy-futures",
        "//third_party/crates:embedded-hal",
        "//third_party/crates:embedded-hal-async",
    ],
)

# bazel run //fw:flash: writes fw.bin over the STM32's ROM USB DFU
# bootloader with dfu-util (flash/flash.rs says how). Manual: never built
# by //..., run in CI or by an agent; it is for the operator, with the
# board on BOOT0. The static dfu-util is x86_64 Linux only.
rust_binary(
    name = "flash",
    srcs = ["flash/flash.rs"],
    data = [
        ":fw_bin",
        "//third_party/dfu_util",
    ],
    rustc_env = {
        "DFU_UTIL": "$(rlocationpath //third_party/dfu_util)",
        "FW_BIN": "$(rlocationpath :fw_bin)",
    },
    tags = ["manual"],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = [":flash_lib"],
)

# //fw:flash's arguments, which CI builds and tests although //fw:flash
# itself is manual.
rust_library(
    name = "flash_lib",
    srcs = ["flash/lib.rs"],
    deps = ["@rules_rust//rust/runfiles"],
)

rust_test(
    name = "flash_lib_test",
    size = "small",
    srcs = ["flash/lib_test.rs"],
    deps = [":flash_lib"],
)
