#
# Host tools for the firmware, std-only Rust: the ELF reader, and elf2bin,
# which writes the raw flash image.
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//fw:__subpackages__"])

rust_library(
    name = "elf",
    srcs = ["elf.rs"],
)

rust_test(
    name = "elf_test",
    size = "small",
    srcs = ["elf_test.rs"],
    deps = [":elf"],
)

rust_binary(
    name = "elf2bin",
    srcs = ["elf2bin.rs"],
    deps = [":elf"],
)

# fw_tables ELF BUDGET MEMMAP: the budget and the memory map as tables,
# for the book (//fw:budget_tsv, //fw:memmap_tsv).
rust_binary(
    name = "fw_tables",
    srcs = ["fw_tables.rs"],
    deps = [":elf"],
)
