#
# The sensor board's circuit (issue #5): a SKiDL script, its netlist, and
# the netlist the same in two configurations. netlist_parity_test checks
# the board against it once the board is here.
load("@hdlf_rules_netlist//netlist:defs.bzl", "determinism_test", "skidl_netlist")

# Every target and source file here is public, so that a module that
# depends on this one (the manual, the book) can quote and build it.
# https://github.com/filmil/hdlf_example_sensor/issues/11
package(default_visibility = ["//visibility:public"])

exports_files(glob(["*"]))

skidl_netlist(
    name = "netlist",
    src = "circuit.py",
    visibility = ["//visibility:public"],
    deps = ["parts.py"],
)

determinism_test(
    name = "netlist_determinism_test",
    size = "small",
    target = ":netlist",
)
