Under Bazel, a build script's CARGO_MANIFEST_DIR is in its own runfiles,
which the link step does not see, so the linker cannot find device.x
there. Copy it into OUT_DIR, which the link step does see.
--- a/build.rs	2026-11-17 07:18:59.680262757 +0100
+++ b/build.rs	2026-11-17 07:18:59.696262749 +0100
@@ -42,11 +42,15 @@
     .replace('_', "-");
 
     #[cfg(feature = "rt")]
-    println!(
-        "cargo:rustc-link-search={}/src/chips/{}",
-        crate_dir.display(),
-        chip_core_name,
-    );
+    {
+        let out_dir = PathBuf::from(env::var_os("OUT_DIR").unwrap());
+        std::fs::copy(
+            crate_dir.join("src/chips").join(&chip_core_name).join("device.x"),
+            out_dir.join("device.x"),
+        )
+        .unwrap();
+        println!("cargo:rustc-link-search={}", out_dir.display());
+    }
 
     println!("cargo:rustc-env=STM32_METAPAC_PAC_PATH=chips/{}/pac.rs", chip_core_name);
     println!(
