# SPDX-License-Identifier: Apache-2.0
#
# The firmware's crates (issue #14): Cargo.toml and Cargo.lock, which
# crate_universe pins them by (MODULE.bazel); crate_licences.txt, each
# crate's SPDX licence; the stm32-metapac patch; and one directory per
# locked crate, <name>-<version>/, with its LICENSE and SOURCE.json
# (written by bazel run //tools/crate_licences).
#
# Targets depend on the aliases here, never on @crates directly. The aliases
# are tagged manual: the crates build only for the firmware's platform, so
# a host build of //... must skip them, as it skipped @crates.
package(default_visibility = ["//visibility:public"])

exports_files([
    "README.md",
    "Cargo.lock",
    "Cargo.toml",
    "crate_licences.txt",
    "stm32-metapac-device-x.patch",
])

# Every crate's LICENSE and SOURCE.json, for //fw:licence_test.
filegroup(
    name = "crate_licence_files",
    srcs = glob([
        "*/LICENSE",
        "*/SOURCE.json",
    ]),
)

alias(
    name = "cortex-m",
    actual = "@crates//:cortex-m",
    tags = ["manual"],
)

alias(
    name = "cortex-m-rt",
    actual = "@crates//:cortex-m-rt",
    tags = ["manual"],
)

