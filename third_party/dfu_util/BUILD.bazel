# SPDX-License-Identifier: Apache-2.0
#
# dfu-util 0.11 (https://dfu-util.sourceforge.net), GPL-2.0-or-later
# (LICENSE, copied from its source distribution), statically linked with
# libusb 1.0.30 (//third_party/libusb) and musl (//third_party/musl). The binary is built from pinned
# sources by //tools/dfu_util, mirrored as the release mirror-dfu-util-0.11,
# and fetched as @dfu_util (MODULE.bazel). Targets depend on this package,
# never on @dfu_util directly.
package(default_visibility = ["//visibility:public"])

licenses(["restricted"])

# The .torrent published next to our copy of dfu-util's source tarball, at
# DfuUtil.URL in //tools/dfu_util (bt.hdlfactory.com's layout: one
# web-seeded .torrent beside each file; README.md says how it is made and
# published).
exports_files([
    "README.md",
    "dfu-util-0.11.tar.gz.torrent",
])

# Manual, like //fw:flash: //... does not fetch the binary. The binary is
# x86_64 Linux only.
alias(
    name = "dfu_util",
    actual = "@dfu_util//file",
    tags = ["manual"],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)
