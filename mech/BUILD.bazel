# SPDX-License-Identifier: Apache-2.0
#
# The enclosure: a 3D-printed tray that the board screws into, closed by the
# milled aluminium front panel. mechanics.bzl has the shared numbers.
load(
    "@hdlf_rules_brep//brep:defs.bzl",
    "cad_assembly",
    "cad_check_test",
    "cad_part",
    "cad_render",
    "determinism_test",
    "interference_test",
    "pcb_fit_test",
)
load(
    ":mechanics.bzl",
    "BOARD",
    "ENCLOSURE",
    "PANEL",
    "SENSOR",
    "USB",
    "board_holes",
    "board_placement",
    "led_center",
    "outer_size",
    "panel_placement",
    "params",
    "post_centers",
)

# Every target and source file here is public, so that a module that
# depends on this one (the manual, the book) can quote and build it.
# https://github.com/filmil/hdlf_example_sensor/issues/11
package(default_visibility = ["//visibility:public"])

exports_files(glob(["*"]))


_PARAMS = params(
    board = BOARD,
    enclosure = ENCLOSURE,
    panel = PANEL,
    sensor = SENSOR,
    usb = USB,
) | {
    "holes": json.encode(board_holes()),
    "led": json.encode(led_center()),
    "outer": json.encode(outer_size()),
    "posts": json.encode(post_centers()),
}

cad_part(
    name = "tray",
    src = "tray.py",
    params = _PARAMS,
)

# The board's outline, holes and USB-C receptacle, until the board's own
# STEP model replaces it.
cad_part(
    name = "board_standin",
    src = "board_standin.py",
    params = _PARAMS,
)

# A USB-C cable's plug at its largest, mated with the receptacle: placed
# like the board, since it is drawn in the board's frame.
cad_part(
    name = "usb_plug",
    src = "usb_plug.py",
    params = _PARAMS,
)

cad_assembly(
    name = "tray_with_board",
    parts = {
        ":board_standin": board_placement(),
        ":tray": "{}",
        ":usb_plug": board_placement(),
    },
)

# The board's holes land on the bosses, and its outline keeps clear of the
# walls and the panel's posts.
pcb_fit_test(
    name = "board_fit_test",
    size = "small",
    board = ":board_standin",
    board_placement = board_placement(),
    enclosure = ":tray",
    min_clearance_mm = "0.8",
)

# Nothing overlaps, the mated plug included: a cable fits through the
# tray's cut-out.
interference_test(
    name = "tray_interference_test",
    size = "small",
    assembly = ":tray_with_board",
)

# Printable: walls of 1.5 mm or more (a 0.4 mm nozzle lays four lines), and
# small enough for any printer's bed.
cad_check_test(
    name = "tray_check_test",
    size = "small",
    max_size = [str(x) for x in outer_size()],
    min_wall = "1.5",
    part = ":tray",
)

cad_render(
    name = "tray_views",
    src = ":tray_with_board",
)

determinism_test(
    name = "tray_determinism_test",
    size = "small",
    target = ":tray",
)

# The plug's margin, tested: a plug grown across (in Y and Z) by just under
# usb_margin (0.4 mm) still fits, and one grown by just over it does not,
# so the cut-out is neither too small nor too large.
cad_part(
    name = "usb_plug_with_margin",
    src = "usb_plug.py",
    params = _PARAMS | {"grow": json.encode(ENCLOSURE["usb_margin"] - 0.05)},
)

cad_assembly(
    name = "tray_with_plug_margin",
    parts = {
        ":tray": "{}",
        ":usb_plug_with_margin": board_placement(),
    },
)

interference_test(
    name = "usb_margin_test",
    size = "small",
    assembly = ":tray_with_plug_margin",
)

# One side at a time, so that each of the four sides is at its margin.
[
    (
        cad_part(
            name = "usb_plug_over_margin_" + name,
            src = "usb_plug.py",
            params = _PARAMS | {
                "grow": json.encode(ENCLOSURE["usb_margin"] + 0.05),
                "grow_side": json.encode(side),
            },
        ),
        cad_assembly(
            name = "tray_with_plug_over_margin_" + name,
            parts = {
                ":tray": "{}",
                ":usb_plug_over_margin_" + name: board_placement(),
            },
        ),
        interference_test(
            name = "usb_margin_upper_" + name + "_test",
            size = "small",
            assembly = ":tray_with_plug_over_margin_" + name,
            expect = "overlap",
        ),
    )
    for name, side in [
        ("left", "y-"),
        ("right", "y+"),
        ("bottom", "z-"),
        ("top", "z+"),
    ]
]

# The front panel, milled from 2 mm aluminium: it closes the tray.
cad_part(
    name = "panel",
    src = "panel.py",
    params = _PARAMS,
)

cad_part(
    name = "fasteners",
    src = "fasteners.py",
    params = _PARAMS,
)

cad_assembly(
    name = "enclosure",
    parts = {
        ":board_standin": board_placement(),
        ":fasteners": "{}",
        ":panel": panel_placement(),
        ":tray": "{}",
        ":usb_plug": board_placement(),
    },
)

# The whole enclosure, closed, with the board, a cable's plug, the panel's
# screws and the light pipe: the panel's holes line up with the tray.
interference_test(
    name = "enclosure_interference_test",
    size = "small",
    assembly = ":enclosure",
)

# Millable: no web thinner than 1 mm in 2 mm aluminium; the tray's outside.
cad_check_test(
    name = "panel_check_test",
    size = "small",
    max_size = [str(x) for x in outer_size()[:2] + [PANEL["thickness"]]],
    min_wall = "1",
    part = ":panel",
)

cad_render(
    name = "enclosure_views",
    src = ":enclosure",
)

determinism_test(
    name = "panel_determinism_test",
    size = "small",
    target = ":panel",
)
