# SPDX-License-Identifier: Apache-2.0
#
# My registry first, then the Bazel Central Registry. These are `common` and
# not `build`, so that `bazel mod`, `bazel query` and `bazel fetch` consult the
# same registries the build does.
common \
  --registry=https://raw.githubusercontent.com/filmil/bazel-registry/main \
  --registry=https://bcr.bazel.build

# Nothing is taken from the host: no C toolchain is detected, so a missing
# hermetic one fails the build rather than falling back to the host's.
common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
build --action_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1

# Actions see a fixed PATH, not the host's, and have no network.
build --incompatible_strict_action_env
build --sandbox_default_allow_network=false

# Python tools start on rules_python's own interpreter, not the host's
# python3 (hdlf_rules_brep's README).
common --@rules_python//python/config_settings:bootstrap_impl=script

# Add your local user settings to file `user.bazelrc`.
try-import %workspace%/user.bazelrc

# The firmware's crates come from this repository's mirror first
# (bazel_downloader.cfg, tools/mirror).
common --downloader_config=bazel_downloader.cfg

# The firmware links with fat LTO (issue #14): rules_rust then builds every
# crate with the bitcode LTO needs. rules_rust remaps the build's paths to
# "." by itself, so they do not reach the ELF.
build --@rules_rust//rust/settings:lto=fat
