#
# A worked example of the hdlf_rules_* modules: a USB-C sensor board in a
# 3D-printed enclosure, with a milled aluminium front panel. Every output
# (schematic-level netlist, board, fab package, enclosure parts, the
# panel's G-code, the user manual) is built hermetically by Bazel.
module(
    name = "hdlf_example_sensor",
    version = "0.0.0",
)

# The hardware rules, from the filmil registry (.bazelrc).
bazel_dep(name = "hdlf_rules_kicad", version = "0.1.0")
bazel_dep(name = "hdlf_rules_netlist", version = "0.0.1")
bazel_dep(name = "hdlf_rules_brep", version = "0.0.1")
bazel_dep(name = "hdlf_rules_fab", version = "0.0.1")
bazel_dep(name = "hdlf_rules_cam", version = "0.2.0")

# A regular dependency, not a dev one: the root BUILD.bazel loads its
# build_test, and a module that depends on this one (the book) must be able
# to load that package (issue #11).
bazel_dep(name = "bazel_skylib", version = "1.9.2")

# The CAD runners of hdlf_rules_brep, the SKiDL runner of hdlf_rules_netlist
# and the board's generator (//pcb) are Python, on rules_python's hermetic
# interpreter. 2.4.6 is the version the graph resolves already.
#
# Two reasons to name it here:
# - .bazelrc sets rules_python's script bootstrap, without which rules_python
#   starts the runners through the host's python3; this makes that flag's
#   label resolve. Bazel reads only the root module's .bazelrc, so a module
#   that depends on this one must set the same flag in its own .bazelrc.
# - pcb/BUILD.bazel loads py_binary from it. It is a regular dependency, not
#   a dev one, so that the package also loads when this module is someone
#   else's dependency (issue #11).
bazel_dep(name = "rules_python", version = "2.4.6")

# KiCad's symbol and footprint libraries (the PCB generator reads the
# footprints), and its 3D models (the PCB's STEP model and renders), fetched
# only when a build uses them.
kicad = use_extension("@hdlf_rules_kicad//kicad:extensions.bzl", "kicad")
use_repo(kicad, "kicad_libs")

models = use_extension("@hdlf_rules_kicad//kicad:models.bzl", "models")
use_repo(models, "kicad_models")

# The build runs on Bazel 9 (.bazelversion) and 8 (CI tests both). Under
# Bazel 8, rules_python (used by hdlf_rules_netlist and hdlf_rules_brep)
# asks for a C++ toolchain though nothing is compiled; the self-contained
# zig toolchain answers, so the host needs none. Bazel 9 does not ask.
bazel_dep(name = "hermetic_cc_toolchain", version = "4.3.0", dev_dependency = True)

zig_toolchains = use_extension(
    "@hermetic_cc_toolchain//toolchain:ext.bzl",
    "toolchains",
    dev_dependency = True,
)
use_repo(zig_toolchains, "zig_sdk")

register_toolchains(
    "@zig_sdk//toolchain:linux_amd64_gnu.2.31",
    dev_dependency = True,
)
