# SPDX-License-Identifier: Apache-2.0
#
# A worked example of the hdlf_rules_* modules: a USB-C sensor board in a
# 3D-printed enclosure, with a milled aluminium front panel. Every output
# (schematic-level netlist, board, fab package, enclosure parts, the
# panel's G-code) is built hermetically by Bazel; the user manual will be
# too, once it lands.
module(
    name = "hdlf_example_sensor",
    version = "0.0.0",
)

# The hardware rules, from the filmil registry (.bazelrc).
bazel_dep(name = "hdlf_rules_kicad", version = "0.1.2")
bazel_dep(name = "hdlf_rules_netlist", version = "0.0.1")
bazel_dep(name = "hdlf_rules_brep", version = "0.0.1")
bazel_dep(name = "hdlf_rules_fab", version = "0.0.1")
bazel_dep(name = "hdlf_rules_cam", version = "0.2.0")

# A regular dependency, not a dev one: the root BUILD.bazel loads its
# build_test, and a module that depends on this one (the book) must be able
# to load that package (issue #11).
bazel_dep(name = "bazel_skylib", version = "1.9.2")

# The CAD runners of hdlf_rules_brep, the SKiDL runner of hdlf_rules_netlist
# and the board's generator (//pcb) are Python, on rules_python's hermetic
# interpreter. 2.4.6 is the version the graph resolves already.
#
# Two reasons to name it here:
# - .bazelrc sets rules_python's script bootstrap, without which rules_python
#   starts brep's CAD runners and the board's generator through the host's
#   python3 (the SKiDL runner sets the script bootstrap itself); this makes
#   that flag's label resolve. Bazel reads only the root module's .bazelrc,
#   so a module that depends on this one must set the same flag in its own
#   .bazelrc.
# - pcb/BUILD.bazel loads py_binary from it. It is a regular dependency, not
#   a dev one, so that the package also loads when this module is someone
#   else's dependency (issue #11).
bazel_dep(name = "rules_python", version = "2.4.6")

# KiCad's symbol and footprint libraries (the PCB generator reads the
# footprints), and its 3D models (the PCB's STEP model and renders), fetched
# only when a build uses them.
kicad = use_extension("@hdlf_rules_kicad//kicad:extensions.bzl", "kicad")
use_repo(kicad, "kicad_libs")

models = use_extension("@hdlf_rules_kicad//kicad:models.bzl", "models")
use_repo(models, "kicad_models")

# The build runs on Bazel 9 (.bazelversion) and 8 (CI tests both). Under
# Bazel 8, rules_python (used by hdlf_rules_netlist and hdlf_rules_brep)
# asks for a C++ toolchain though nothing is compiled; the self-contained
# zig toolchain answers, so the host needs none. Bazel 9 does not ask.
bazel_dep(name = "hermetic_cc_toolchain", version = "4.3.0", dev_dependency = True)

zig_toolchains = use_extension(
    "@hermetic_cc_toolchain//toolchain:ext.bzl",
    "toolchains",
    dev_dependency = True,
)
use_repo(zig_toolchains, "zig_sdk")

register_toolchains(
    "@zig_sdk//toolchain:linux_amd64_gnu.2.31",
    dev_dependency = True,
)

# The sensor's firmware (issue #14): Rust 1.100.0 on rules_rust, for the
# STM32F042's Cortex-M0 (thumbv6m-none-eabi) and for host tests. rules_rust
# 0.75.0 knows hashes up to 1.99.0, so 1.100.0's are given here, from
# static.rust-lang.org's .sha256 files. The mirror, a release of this
# repository, is tried first, then the same files on bt.hdlfactory.com
# (tools/mirror --to=bt), then static.rust-lang.org.
bazel_dep(name = "rules_rust", version = "0.75.0")

# The firmware's platform (//fw:stm32f042) names its CPU and OS.
bazel_dep(name = "platforms", version = "1.1.0")

# tools/mirror, ported from bazel_rules_em, is Go. The hdlf_rules_* modules
# already resolve rules_go to this version; the direct dep only names it.
bazel_dep(name = "rules_go", version = "0.64.2")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    extra_target_triples = ["thumbv6m-none-eabi"],
    rustfmt_version = "1.100.0",
    sha256s = {
        "cargo-1.100.0-x86_64-unknown-linux-gnu": "7e29ce07d7c6e92d1826870575ba27d57fff6cb3e754aa57d99099cb88fab35d",
        "clippy-1.100.0-x86_64-unknown-linux-gnu": "0d18df3bff6c852ef8243727fed075ecb33dbf93b8ab8c138c2f45e3f270102a",
        "llvm-tools-1.100.0-x86_64-unknown-linux-gnu": "2c84cada1aef73339b1a2d101a35cd78d71072c8f6a3921bf1abb852c3f42ad3",
        "rust-std-1.100.0-thumbv6m-none-eabi": "46e69999d8ddf1ccaebe1aea0295c384ba78eb1d3892af187d23ee20c89b5513",
        "rust-std-1.100.0-x86_64-unknown-linux-gnu": "4591b6486594ded52ecd6135db95bf9355bbd3ca7a380888b141528bbcf9a5d4",
        "rustc-1.100.0-x86_64-unknown-linux-gnu": "f1d0b1dec81dab6f523cd098507763487b0d4bd7fd2c87582f154128719be03b",
        "rustfmt-1.100.0-x86_64-unknown-linux-gnu": "4c9389e4722b16499e5d47d89837ec84a4ef755f105ed2a84c038156064e01ab",
    },
    urls = [
        "https://github.com/filmil/hdlf_example_sensor/releases/download/mirror-rust-1.100.0/{}.tar.xz",
        "https://bt.hdlfactory.com/rust/1.100.0/{}.tar.xz",
        "https://static.rust-lang.org/dist/{}.tar.xz",
    ],
    versions = ["1.100.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# The firmware's crates, pinned by Cargo.lock's checksums, and
# cargo-bazel-lock.json, crate_universe's own lockfile, which a module that
# others depend on must ship (bazel-cad-book depends on this one). To change
# the crates, edit third_party/crates/Cargo.toml and run
# CARGO_BAZEL_REPIN=1 bazel mod tidy, which rewrites both lockfiles. Run it
# also after changing crate.from_cargo or crate.annotation below, the
# stm32-metapac patch, or rules_rust's version: each invalidates
# cargo-bazel-lock.json, and a build without the repin fails. After a
# crate change, also bazel run //tools/crate_licences, update
# third_party/crates/crate_licences.txt, and add an alias in
# third_party/crates/BUILD.bazel for each new direct dependency.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//third_party/crates:Cargo.lock",
    lockfile = "//third_party/crates:cargo-bazel-lock.json",
    manifests = ["//third_party/crates:Cargo.toml"],
    supported_platform_triples = [
        "thumbv6m-none-eabi",
        "x86_64-unknown-linux-gnu",
    ],
)

# stm32-metapac's build script points the linker at device.x in its own
# source directory, which Bazel's link step does not see. So the
# annotation exports device.x as a filegroup, @crates//:stm32-metapac-device-x,
# and //fw:fw_code adds it to its inputs and its directory to the link
# search path. There is no patch: rules_rust writes an annotation's
# patches into cargo-bazel-lock.json as labels of the root module
# ("@@//..."), so they break every module that depends on this one
# (https://github.com/bazelbuild/rules_rust/pull/4425).
#
# The chip's metadata (its pins, and each peripheral's pins with their
# alternate functions) is also a filegroup, @crates//:stm32-metapac-metadata,
# which //fw:pins_rs checks the board's netlist against.
crate.annotation(
    additive_build_file_content = """
filegroup(
    name = "chip_metadata",
    srcs = [
        "src/chips/metadata_0043.rs",
        "src/chips/stm32f042f6/metadata.rs",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "device_x",
    srcs = ["src/chips/stm32f042f6/device.x"],
    visibility = ["//visibility:public"],
)
""",
    build_script_data_glob = ["src/chips/stm32f042f6/device.x"],
    crate = "stm32-metapac",
    extra_aliased_targets = {
        "stm32-metapac-device-x": "device_x",
        "stm32-metapac-metadata": "chip_metadata",
    },
)

# The crate's own repository, for the directory of its device.x
# (//fw:fw_code). Its name holds the crate's version.
use_repo(crate, "crates", "crates__stm32-metapac-21.0.0")

# dfu-util 0.11, static with libusb 1.0.30, for //fw:flash (issue #14, step
# 5): built by tools/dfu_util and mirrored as the release
# mirror-dfu-util-0.11 and on bt.hdlfactory.com (tools/mirror --to=bt).
# Bazel fetches it from the GitHub release first, then from bt.
# //fw:flash is manual, so no other build fetches it.
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_file(
    name = "dfu_util",
    executable = True,
    sha256 = "95fdbb4cdaefe1762bd88f5b97ff5da1b8cf997a9bcf65c4cdf15658dd917106",
    urls = [
        "https://github.com/filmil/hdlf_example_sensor/releases/download/mirror-dfu-util-0.11/dfu-util",
        "https://bt.hdlfactory.com/dfu-util/0.11/dfu-util",
    ],
)
