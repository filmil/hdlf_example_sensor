# SPDX-License-Identifier: Apache-2.0
#
# A worked example of the hdlf_rules_* modules: a USB-C sensor board in a
# 3D-printed enclosure, with a milled aluminium front panel. Every output
# (schematic-level netlist, board, fab package, enclosure parts, the
# panel's G-code, the user manual) is built hermetically by Bazel.
module(
    name = "hdlf_example_sensor",
    version = "0.0.0",
)

# The hardware rules, from the filmil registry (.bazelrc).
bazel_dep(name = "hdlf_rules_kicad", version = "0.0.1")
bazel_dep(name = "hdlf_rules_netlist", version = "0.0.1")
bazel_dep(name = "hdlf_rules_brep", version = "0.0.1")
bazel_dep(name = "hdlf_rules_fab", version = "0.0.1")
bazel_dep(name = "hdlf_rules_cam", version = "0.0.1")

bazel_dep(name = "bazel_skylib", version = "1.9.2")

# Under Bazel 8, rules_python (used by hdlf_rules_netlist and
# hdlf_rules_brep) asks for a C++ toolchain though nothing is compiled; the
# self-contained zig toolchain answers, so the host needs none.
bazel_dep(name = "hermetic_cc_toolchain", version = "4.3.0")

zig_toolchains = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")
use_repo(zig_toolchains, "zig_sdk")

register_toolchains("@zig_sdk//toolchain:linux_amd64_gnu.2.31")
