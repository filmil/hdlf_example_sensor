load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

# The mirror of what the firmware's build downloads: the Rust toolchain's
# tarballs and the crates of third_party/crates/Cargo.lock (issue #14), as release assets
# of this repository. Ported from bazel_rules_em.
#
#   bazel run //tools/mirror    checks every upstream file of manifest.json
#
# The operator uploads with --dry_run=false (see cmd/main.go). The test
# runs the checks against a local server, never the network, and keeps
# manifest.json equal to what MODULE.bazel and third_party/crates/Cargo.lock fetch.

go_library(
    name = "mirror_lib",
    srcs = ["mirror.go"],
    importpath = "github.com/filmil/hdlf_example_sensor/tools/mirror",
    visibility = ["//visibility:private"],
)

go_test(
    name = "mirror_test",
    size = "small",
    srcs = [
        "mirror_test.go",
        "sensor_test.go",
    ],
    data = [
        "manifest.json",
        "//:MODULE.bazel",
        "//:bazel_downloader.cfg",
        "//third_party/crates:Cargo.lock",
    ],
    embed = [":mirror_lib"],
    pure = "on",
    deps = ["@rules_go//go/runfiles"],
)

go_binary(
    name = "mirror",
    srcs = ["cmd/main.go"],
    pure = "on",
    deps = [":mirror_lib"],
)

# //tools/dfu_util's test checks dfu-util's entry.
exports_files(
    ["manifest.json"],
    visibility = ["//tools/dfu_util:__pkg__"],
)
